<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SheetMusicViewer.Desktop"
        x:Class="SheetMusicViewer.Desktop.MetaDataFormWindow"
        x:DataType="local:MetaDataFormViewModel"
        x:Name="MetaDataWindow"
        Title="{Binding Title}"
        Width="1200"
        Height="700"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top toolbar with buttons -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10" Spacing="10">
            <TextBlock Text="PageNumberOffset:" VerticalAlignment="Center"/>
            <TextBox Text="{Binding PageNumberOffset}" Width="50"/>
            <Button Content="_Add Row" Command="{Binding AddRowCommand}"
                    ToolTip.Tip="Add a new TOC entry"/>
            <Button Content="_Delete Row" Command="{Binding DeleteRowCommand}"
                    ToolTip.Tip="Delete the selected TOC entry"/>
            <Button Content="_Import from Clipboard" Command="{Binding ImportCommand}" 
                    ToolTip.Tip="Import TOC from clipboard tab separated values (PageNo, SongName, Composer, Date, Notes)"/>
            <Button Content="_Export to Clipboard" Command="{Binding ExportCommand}"
                    ToolTip.Tip="Export TOC to clipboard to paste to Excel"/>
            <Button Content="_Cancel" Command="{Binding CancelCommand}"/>
            <Button Content="_Save" Command="{Binding SaveCommand}"/>
        </StackPanel>

        <!-- Header info panel -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thumbnail image -->
            <Image Grid.Column="0" 
                   Source="{Binding Thumbnail}" 
                   Width="100" 
                   Height="200" 
                   Stretch="Uniform"
                   Margin="0,0,20,0"/>

            <!-- Edit panel for selected item -->
            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="5" Width="400">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PageNo:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.PageNo, Mode=TwoWay}" Width="60" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="SongName:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.SongName, Mode=TwoWay}" IsEnabled="{Binding SongNameIsEnabled}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Composer:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.Composer, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Date:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.Date, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Notes, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Link:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.Link, Mode=TwoWay}" 
                             ToolTip.Tip="URL link (e.g., YouTube video)"/>
                    <Button Grid.Row="5" Grid.Column="2" Content="Open" Command="{Binding OpenLinkCommand}" 
                            IsEnabled="{Binding SelectedItemHasLink}" Margin="5,0,0,0"
                            ToolTip.Tip="Open link in browser"/>
                </Grid>
            </StackPanel>

            <!-- Volume Info panel -->
            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="20,0,0,0">
                <TextBlock Text="VolInfo:" FontWeight="Bold"/>
                <ListBox ItemsSource="{Binding VolInfoDisplay}" MaxHeight="120" MinWidth="400">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>

        <!-- Main content with TOC DataGrid and Favorites -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOC DataGrid -->
            <DataGrid Grid.Column="0"
                      Name="TocDataGrid"
                      ItemsSource="{Binding TocEntries}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      GridLinesVisibility="All"
                      CanUserReorderColumns="True"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      DoubleTapped="TocDataGrid_DoubleTapped">
                <DataGrid.Columns>
                    <DataGridTextColumn Binding="{Binding PageNo}" Width="75" x:DataType="local:TocEntryViewModel">
                        <DataGridTextColumn.Header>
                            <Border HorizontalAlignment="Stretch" Background="Transparent" ToolTip.Tip="Page number in the book (uses PageNumberOffset)">
                                <TextBlock Text="Page"/>
                            </Border>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding FavDisplay}" Width="65" IsReadOnly="True" x:DataType="local:TocEntryViewModel">
                        <DataGridTextColumn.Header>
                            <Border HorizontalAlignment="Stretch" Background="Transparent" ToolTip.Tip="★ — this song is marked as a favorite">
                                <TextBlock Text="Fav"/>
                            </Border>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding LinkDisplay}" Width="65" IsReadOnly="True" x:DataType="local:TocEntryViewModel">
                        <DataGridTextColumn.Header>
                            <Border HorizontalAlignment="Stretch" Background="Transparent" ToolTip.Tip="🔗 — this song has a linked URL (e.g. YouTube). Double-click to open.">
                                <TextBlock Text="Lnk"/>
                            </Border>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Width="65" IsReadOnly="True" x:DataType="local:TocEntryViewModel">
                        <DataGridTemplateColumn.Header>
                            <Border HorizontalAlignment="Stretch" Background="Transparent" ToolTip.Tip="🎵 — a cached MusicXML (.mxl) file exists for this song. Click to open in MuseScore.">
                                <TextBlock Text="MXL"/>
                            </Border>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TocEntryViewModel">
                                <Button Content="🎵"
                                        Command="{Binding OpenInMuseScoreCommand}"
                                        IsVisible="{Binding HasCachedMxl}"
                                        Padding="2"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="Open cached MXL in MuseScore"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="500" x:DataType="local:TocEntryViewModel">
                        <DataGridTemplateColumn.Header>
                            <Border HorizontalAlignment="Stretch" Background="Transparent" ToolTip.Tip="Song title — double-click a row to navigate to that page">
                                <TextBlock Text="SongName"/>
                            </Border>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate x:DataType="local:TocEntryViewModel">
                                <TextBlock Text="{Binding SongName}" VerticalAlignment="Center" Margin="2,0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate x:DataType="local:TocEntryViewModel">
                                <TextBox Text="{Binding SongName, Mode=TwoWay}" 
                                         IsEnabled="{Binding #MetaDataWindow.((local:MetaDataFormViewModel)DataContext).SongNameIsEnabled}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Binding="{Binding Composer}" Width="200" x:DataType="local:TocEntryViewModel">
                        <DataGridTextColumn.Header>
                            <Border HorizontalAlignment="Stretch" Background="Transparent" ToolTip.Tip="Composer name">
                                <TextBlock Text="Composer"/>
                            </Border>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Date}" Width="100" x:DataType="local:TocEntryViewModel">
                        <DataGridTextColumn.Header>
                            <Border HorizontalAlignment="Stretch" Background="Transparent" ToolTip.Tip="Composition or publication date">
                                <TextBlock Text="Date"/>
                            </Border>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                    <DataGridTextColumn Binding="{Binding Notes}" Width="*" x:DataType="local:TocEntryViewModel">
                        <DataGridTextColumn.Header>
                            <Border HorizontalAlignment="Stretch" Background="Transparent" ToolTip.Tip="Additional notes about this song">
                                <TextBlock Text="Notes"/>
                            </Border>
                        </DataGridTextColumn.Header>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"/>

            <!-- Favorites panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Favorites:" FontWeight="Bold" Margin="5,0,0,5"/>
                <Grid Grid.Row="1" Name="FavoritesPanel"/>
            </Grid>
        </Grid>
    </Grid>
</Window>


