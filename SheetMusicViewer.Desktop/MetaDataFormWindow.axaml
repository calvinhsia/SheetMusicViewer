<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SheetMusicViewer.Desktop"
        x:Class="SheetMusicViewer.Desktop.MetaDataFormWindow"
        x:DataType="local:MetaDataFormViewModel"
        x:Name="MetaDataWindow"
        Title="{Binding Title}"
        Width="1200"
        Height="700"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu bar + right-aligned Save/Cancel toolbar -->
        <DockPanel Grid.Row="0" Margin="0,0,0,6">

            <!-- Menu (left) -->
            <Menu DockPanel.Dock="Left" VerticalAlignment="Center">

                <!-- Edit menu — TOC row operations -->
                <MenuItem Header="_Edit">
                    <MenuItem Header="_Add Row"
                              Command="{Binding AddRowCommand}"
                              ToolTip.Tip="Add a new TOC entry"/>
                    <MenuItem Header="_Delete Row"
                              Command="{Binding DeleteRowCommand}"
                              ToolTip.Tip="Delete the selected TOC entry"/>
                    <Separator/>
                    <MenuItem Header="_Import from Clipboard"
                              Command="{Binding ImportCommand}"
                              ToolTip.Tip="Import TOC from clipboard (tab-separated: PageNo, SongName, Composer, Date, Notes)"/>
                    <MenuItem Header="_Export to Clipboard"
                              Command="{Binding ExportCommand}"
                              ToolTip.Tip="Export TOC to clipboard for pasting into Excel"/>
                </MenuItem>

                <!-- Tools menu — OCR and other utilities -->
                <MenuItem Header="_Tools">
                    <MenuItem Header="E_xtract TOC from PDF (OCR)…"
                              Command="{Binding ExtractTocFromOcrCommand}"
                              ToolTip.Tip="Render each page, run Windows OCR on the top strip, and show raw text + suggested TOC JSON in a text window"/>
                </MenuItem>

            </Menu>

            <!-- Right-aligned: PageNumberOffset + Cancel + Save -->
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="8">
                <TextBlock Text="PageNumberOffset:" VerticalAlignment="Center"/>
                <TextBox Text="{Binding PageNumberOffset}" Width="50"
                         ToolTip.Tip="The PageNumberOffset setting maps between physical PDF pages and printed page numbers. The TOC uses printed page numbers, so this value is added to the raw OCR page index when generating the suggested TOC."/>
                <Button Content="_Cancel" Command="{Binding CancelCommand}"/>
                <Button Content="_Save"   Command="{Binding SaveCommand}"/>
            </StackPanel>

            <!-- spacer so menu and toolbar don't overlap -->
            <Border/>

        </DockPanel>

        <!-- OCR progress bar — visible only while OCR is running -->
        <Grid Grid.Row="1"
              IsVisible="{Binding IsOcrRunning}"
              Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2">
                <TextBlock Text="{Binding OcrStatusText}" FontSize="12"/>
                <ProgressBar Value="{Binding OcrProgressPercent}" Minimum="0" Maximum="100" Height="12"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Cancel OCR" Margin="8,0,0,0"
                    Command="{Binding CancelOcrCommand}"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- Header info panel -->
        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Thumbnail image -->
            <Image Grid.Column="0" 
                   Source="{Binding Thumbnail}" 
                   Width="100" 
                   Height="200" 
                   Stretch="Uniform"
                   Margin="0,0,20,0"/>

            <!-- Edit panel for selected item -->
            <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="5" Width="400">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PageNo:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedItem.PageNo, Mode=TwoWay}" Width="60" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="SongName:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedItem.SongName, Mode=TwoWay}" IsEnabled="{Binding SongNameIsEnabled}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Composer:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedItem.Composer, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Date:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedItem.Date, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Notes:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedItem.Notes, Mode=TwoWay}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Link:" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,5,0"/>
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding SelectedItem.Link, Mode=TwoWay}" 
                             ToolTip.Tip="URL link (e.g., YouTube video)"/>
                    <Button Grid.Row="5" Grid.Column="2" Content="Open" Command="{Binding OpenLinkCommand}" 
                            IsEnabled="{Binding SelectedItemHasLink}" Margin="5,0,0,0"
                            ToolTip.Tip="Open link in browser"/>
                </Grid>
            </StackPanel>

            <!-- Volume Info panel -->
            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="20,0,0,0">
                <TextBlock Text="VolInfo:" FontWeight="Bold"/>
                <ListBox ItemsSource="{Binding VolInfoDisplay}" MaxHeight="120" MinWidth="400">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Grid>

        <!-- Main content with TOC DataGrid and Favorites -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- TOC BrowseControl (built in code-behind) -->
            <Grid Grid.Column="0" Name="TocPanel"/>

            <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns"/>

            <!-- Favorites panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Favorites:" FontWeight="Bold" Margin="5,0,0,5"/>
                <Grid Grid.Row="1" Name="FavoritesPanel"/>
            </Grid>
        </Grid>
    </Grid>
</Window>


