<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsTestProject>true</IsTestProject>
    <LangVersion>latest</LangVersion>
    <StartupObject>AvaloniaTests.Program</StartupObject>

    <!-- Suppress CA1416: PDFtoImage is platform-specific but tests only run on desktop platforms (Windows, Linux, macOS) -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SheetMusicLib\SheetMusicLib.csproj" />
    <ProjectReference Include="..\SheetMusicViewer.Desktop\SheetMusicViewer.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.9" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.21.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="11.3.9" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.9" />
    <PackageReference Include="Avalonia.Headless" Version="11.3.9" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.9" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.9" />
    <PackageReference Include="Avalonia.Diagnostics" Version="11.3.9" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.7.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.7.0" />
    <PackageReference Include="PDFtoImage" Version="5.0.0" />
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <!-- Tesseract language data — see Desktop project for download notes -->
  <PropertyGroup>
    <TessdataDir Condition="'$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)tessdata\</TessdataDir>
    <TessdataDir Condition="'$(TessdataDir)' == ''">$(MSBuildProjectDirectory)\..\tessdata\</TessdataDir>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="$(TessdataDir)eng.traineddata"
             CopyToOutputDirectory="PreserveNewest"
             Link="tessdata\eng.traineddata"
             Condition="Exists('$(TessdataDir)eng.traineddata')" />
  </ItemGroup>

  <!--
    Download target intentionally omitted here: SheetMusicViewer.Desktop builds first
    (it is a ProjectReference) and its DownloadTessdata target will have already
    fetched the file before this project's build starts.
    If you build AvaloniaTests in isolation, build Desktop once first.
  -->

</Project>
